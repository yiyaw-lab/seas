__pycache__/
*.pyc
.env
.venv/

# Transient runtime data: refreshed each run by src/fetch_signals.py
data/signals.json

# Runtime taste store (populated as Yiya teaches it; like signals.json)
data/taste_signals.json

# Local backup of the project log from the 2026-06-05 reindex (recovery only)
data/argo_projects.backup-20260605.json

# Transient Telegram bot read-offset (argo_rate.py)
argo/telegram_offset.json

# Local chat memory log (durable copy lives on the Railway volume)
data/argo_chat.json

# Private / trade-secret — never commit
private/
COST_PLAYBOOK.md

# Strategy / vision / design docs — keep local, not in the repo
BRAND.md
VISION.md
ROADMAP.md
ROADMAP.html
argo-v3-deck.html
seasar-landing.html
proof-draft.html
docs/DESIGN_dispatch_to_coder.md

# Investor / pitch letters and internal HTML build reports
docs/build-log/2026-06-05-release-letter.md
docs/build-log/*.html

# Personal taste + strategy data — runtime state, not public reference
data/argo_projects.json
data/argo_bets.json

# Files the user sends Argo over Telegram (argo_webhook saves them; the durable
# copy lives on the Railway volume via ARGO_FILES_DIR)
data/files/

# Transient daily-budget counter (argo_guard)
data/argo_budget.json

# Transient pending self-heal action (argo_mcp_server L1)
data/argo_pending_heal.json

# Argo's self-model: beliefs about itself + reflection state (argo_self).
# Per-deploy runtime state; schema documented in data/argo_self.example.json.
data/argo_self.json

# Self-diagnosis ledgers (argo_incidents / argo_diagnose): the operational-failure
# rollup Argo reads back, and the fix-PR ledger that joins a proposal to its belief.
# Per-deploy runtime state; point ARGO_INCIDENTS_PATH / ARGO_PROPOSALS_PATH at the
# Railway volume so they survive redeploys.
data/argo_incidents.json
data/argo_proposals.json

# Frontier-evolution stores (argo_evolve / argo_predictions): the release-watch
# seen-store, lever ledger, EVOLVE staging slot, prediction store, and the local
# scheduler's dedupe state. Runtime state; ARGO_* overrides point them at the
# Railway volume. (frontier_feeds.json and stack_manifest.json stay committed.)
data/argo_frontier_seen.json
data/argo_evolution.json
data/argo_pending_evolve.json
data/argo_predictions.json
data/schedule_state_local.json

# Local Claude Code agent config (not project code)
.claude/
data/profile.json

# Rehearse blueprints + the full debate transcript (transcripts.jsonl) are
# generated per-rehearsal output: large, may quote sources, kept local for
# eval/research. On Railway, ARGO_REHEARSE_LOG can point at the mounted volume.
argo/rehearsals/

# V1-era personal output files (observations and project bets)
argo/observations/
argo/projects/

# SEAS runtime outputs: scored opportunities, capability inventory, enrichment cache
data/ledger.json
data/capabilities.json
data/opportunities.json

# SEAS job run artifacts (JSON outputs in subdirs; .md design docs stay)
runs/**/*.json
